# Copy to .env for local development. In staging/production, inject these
# via the container orchestrator's secret/config mechanism instead of a
# committed file (SDD Section 16 - Security: Secrets Management).

# --- Application ---
APP_NAME=job-processing-service
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/v1

# --- Persistence layer (SDD Section 7.4) ---
DATABASE_URL=postgresql+asyncpg://jobsystem:changeme@localhost:5432/jobsystem
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Queue / broker + cache layer (SDD Section 7.2, 7.5) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
STATUS_CACHE_TTL_SECONDS=30

# --- Retry strategy defaults (SDD Section 10) ---
JOB_DEFAULT_MAX_RETRIES=5
JOB_RETRY_BASE_DELAY_SECONDS=2
JOB_RETRY_MAX_DELAY_SECONDS=32

# --- Data retention (SDD NFR8) ---
JOB_RETENTION_DAYS=30

# --- Security (SDD Section 16) ---
# Reused from the existing platform auth per SDD Section 5 (Assumptions) -
# populate with the real signing key / issuer once available.
SECRET_KEY=changeme-local-dev-only
JWT_ALGORITHM=HS256
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000
MAX_PAYLOAD_SIZE_BYTES=65536
ALLOWED_OPERATIONS=rag_query

# --- Logging (SDD Section 17) ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Metrics (SDD Section 18) ---
# Required for the WORKER's /metrics to work correctly (see
# app/workers/celery_app.py) - must be a writable, empty directory, unique
# per worker container/pod (not shared across replicas). Not needed for
# the API, which doesn't use multiprocess mode.
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
