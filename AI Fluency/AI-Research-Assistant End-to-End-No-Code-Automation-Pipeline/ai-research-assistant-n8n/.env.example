# Copy this file to .env and fill in real values.
# Never commit a real .env file. See docs/security.md.

# --- n8n instance settings (self-hosted only; skip if using n8n Cloud) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
TZ=UTC
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Workflow-level environment variables (docs/n8n-configuration.md, Section 2) ---
SEARCH_API_PROVIDER=tavily
DRIVE_FOLDER_ID=replace-with-your-google-drive-folder-id
NOTIFY_EMAIL=you@example.com
MAX_SEARCH_RESULTS=8
LLM_MODEL=replace-with-your-provider-current-model-string

# --- API keys are NOT set here — they are stored only in n8n's encrypted ---
# --- credential store. See docs/api-setup-guide.md.                      ---
