# FL-04 MCP Filesystem Integration — environment variables
# Copy this file to .env and adjust as needed. Never commit the real .env.

# Root directory the filesystem MCP server is allowed to access.
# This is a least-privilege boundary: the server can see this folder
# and its subfolders only — nothing else on disk.
MCP_FS_ROOT=/mnt/project

# --- Part 3: n8n integration ---
# Set this as an environment variable inside your n8n instance (not this
# project's .env). It's the writable folder the "MCP: Stage Report to
# Disk" node writes into. It MUST be the same directory (or a subfolder
# of it) that the filesystem MCP server was started with, or write_file
# calls will be rejected as out-of-scope.
MCP_STAGING_ROOT=/data/fl04-staging
