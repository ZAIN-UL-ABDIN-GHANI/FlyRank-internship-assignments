# App
APP_NAME=scraper-service
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database (matches the local Postgres container credentials in docker-compose.yml)
DATABASE_URL=postgresql://scraper:scraper@db:5432/scraper

# Redis
REDIS_URL=redis://redis:6379/0

# Responsible crawling (config surface consumed starting Phase 3+)
USER_AGENT="scraper-service-bot/1.0 (+https://example.com/bot-info)"
REQUEST_RATE_LIMIT_DELAY_SECONDS=1.5
MAX_RETRIES=3
